			"listen": "prerequest",
			"script": {
				"exec": [
					"// Nếu dùng Bearer Token thủ công từ biến {{access_token}} khi Postman không auto-fetch:",
					"const reqName = pm.info.requestName || \"\";",
					"const isNoAuthTest = reqName.includes(\"Không Token\");",
					"const hasAuthHeader = pm.request.headers.has(\"Authorization\");",
					"if (!isNoAuthTest && !hasAuthHeader && pm.collectionVariables.get(\"access_token\")) {",
					"    pm.request.headers.upsert({ key: \"Authorization\", value: \"Bearer \" + pm.collectionVariables.get(\"access_token\") });",
					"}"
				],
				"type": "text/javascript"
			}

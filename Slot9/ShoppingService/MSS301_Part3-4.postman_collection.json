	"item": [
		{
			"name": "0. Keycloak & Auth",
			"item": [
				{
					"name": "T6.3 - OpenID Discovery Configuration",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Issuer khớp với cấu hình Keycloak\", function () {",
									"    pm.expect(jsonData.issuer).to.eql(pm.collectionVariables.get(\"keycloak\"));",
									"});",
									"pm.test(\"Có token_endpoint và jwks_uri\", function () {",
									"    pm.expect(jsonData.token_endpoint).to.not.be.empty;",
									"    pm.expect(jsonData.jwks_uri).to.not.be.empty;",
									"});",
									"pm.test(\"Hỗ trợ grant_type client_credentials\", function () {",
									"    pm.expect(jsonData.grant_types_supported).to.include(\"client_credentials\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{keycloak}}/.well-known/openid-configuration",
							"host": [
								"{{keycloak}}"
							],
							"path": [
								".well-known",
								"openid-configuration"
							]
						},
						"description": "Kiểm tra endpoint discovery của Keycloak realm"
					},
					"response": []
				},
				{
					"name": "T6.4 - Lấy Token Client Credentials",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Có trường access_token\", function () {",
									"    pm.expect(jsonData.access_token).to.not.be.empty;",
									"    pm.expect(jsonData.token_type).to.eql(\"Bearer\");",
									"});",
									"if (jsonData.access_token) {",
									"    pm.collectionVariables.set(\"access_token\", jsonData.access_token);",
									"    console.log(\"Đã lưu access_token vào collectionVariables!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "client_credentials",
									"type": "text"
								},
								{
									"key": "client_id",
									"value": "{{clientId}}",
									"type": "text"
								},
								{
									"key": "client_secret",
									"value": "{{clientSecret}}",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{keycloak}}/protocol/openid-connect/token",
							"host": [
								"{{keycloak}}"
							],
							"path": [
								"protocol",
								"openid-connect",
								"token"
							]
						},
						"description": "Lấy JWT Access Token từ Keycloak và tự động lưu vào biến collection 'access_token'"
					},
					"response": []
				},
				{
					"name": "T6.6 - Lấy Token Sai Secret (Negative 401)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Bị từ chối 401 Unauthorized\", function () {",
									"    pm.response.to.have.status(401);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Mã lỗi unauthorized_client\", function () {",
									"    pm.expect(jsonData.error).to.eql(\"unauthorized_client\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "client_credentials",
									"type": "text"
								},
								{
									"key": "client_id",
									"value": "{{clientId}}",
									"type": "text"
								},
								{
									"key": "client_secret",
									"value": "sai-secret-invalid",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{keycloak}}/protocol/openid-connect/token",
							"host": [
								"{{keycloak}}"
							],
							"path": [
								"protocol",
								"openid-connect",
								"token"
							]
						},
						"description": "Kiểm tra Keycloak từ chối cấp token khi sai client secret"
					},
					"response": []
				}
			]
		},
